# Shared look for every demo clip. Sourced by the other tapes.
# Black and white with the #0000ed accent, to match `penthera ui`. Blue and
# cyan are lifted to #5c5cff and #8a8aff so they read on black.
Set Shell "bash"
Set FontSize 18
Set Width 1280
Set Height 760
Set Padding 24
Set Theme { "name": "Penthera", "background": "#000000", "foreground": "#f2f2f2", "cursor": "#f2f2f2", "selection": "#0000ed", "black": "#000000", "brightBlack": "#8c8c8c", "red": "#ff5f5f", "brightRed": "#ff8787", "green": "#d7d7d7", "brightGreen": "#ffffff", "yellow": "#ffd75f", "brightYellow": "#ffe08a", "blue": "#5c5cff", "brightBlue": "#8a8aff", "magenta": "#b4b4ff", "brightMagenta": "#d0d0ff", "cyan": "#8a8aff", "brightCyan": "#b4b4ff", "white": "#d7d7d7", "brightWhite": "#ffffff" }
Set TypingSpeed 45ms
Set WindowBar Rings
Set WindowBarSize 36
Set BorderRadius 0
Set Margin 0
